# SHEscale Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── MongoDB ──────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string_here
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/shescale

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ───────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Encrypted Storage (for sensitive doc refs) ───────────
ENCRYPTED_STORAGE_BUCKET=your_secure_bucket_name
ENCRYPTED_STORAGE_SECRET=your_storage_secret
